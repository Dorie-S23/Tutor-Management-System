# Copy to .env and fill in real values — .env is gitignored.
# Variable names matter: app.js and server/supabaseClient.js read SUPABASE_ANON_KEY
# specifically (not SUPABASE_KEY).

# Required — from your Supabase project's Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional — Google AI Studio key for timetable PDF parsing (POST /api/timetable/parse).
# Without it that route answers 503 and the calendar page falls back to on-device OCR.
GEMINI_API_KEY=

# Optional — overrides the Gemini model used and disables model failover (defaults to a cascade starting at gemini-3.5-flash-lite)
GEMINI_MODEL=

# Optional — server port (defaults to 3000)
PORT=3000
