{
  "name": "tutor-management-system",
  "version": "1.1.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageProvider": "v8",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/my-docs/"
    ],
    "collectCoverageFrom": [
      "public/js/**/*.js",
      "server/routes/**/*.js",
      "!**/*.test.js",
      "!**/node_modules/**"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://sdp.ms.wits.ac.za/the-devden/Tutor-Management-System.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "jsdom": "^26.1.0",
    "prettier": "3.9.6",
    "supertest": "^7.2.2",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  }
}
